# dexpaprika configuration — EXAMPLE ONLY. Copy to .env for local dev.
# .env is gitignored; real secrets live in the OS keyring (local) or the
# cloud secret manager (later) — see ARCHITECTURE.md §4. Values here are
# documented dummies.

# --- core ---
DEXPAPRIKA_DATA_DIR=./data            # the ONLY directory the system reads/writes
DEXPAPRIKA_LOG_LEVEL=INFO

# --- chains / providers (S1+ wires these; endpoint lists are config, not code) ---
DEXPAPRIKA_BASE_RPC_URLS=https://base-rpc.publicnode.com,https://base.llamarpc.com
DEXPAPRIKA_ARBITRUM_RPC_URLS=https://arb1.arbitrum.io/rpc
DEXPAPRIKA_GMX_REST_PEERS=https://arbitrum.gmxapi.io/v1,https://arbitrum.gmxapi.ai/v1
DEXPAPRIKA_DEXPAPRIKA_BASE_URL=https://api.dexpaprika.com

# --- secrets (NAMES only; values come from keyring/secret manager, never .env
#     in real use — shown here to document what exists) ---
# keyring service "dexpaprika": github_pat, ntfy_topic, dexpaprika_api_key (optional),
#                               krystal_api_key (optional), coinstats_api_key (optional)

# --- alerts ---
DEXPAPRIKA_NTFY_SERVER=https://ntfy.sh

# --- S9 hard limits (enforced in code before the client layer; see §7) ---
DEXPAPRIKA_MAX_POSITION_USD=0         # 0 = execution disabled
DEXPAPRIKA_MAX_DELTA_PER_RUN_USD=0
DEXPAPRIKA_MAX_DAILY_ADJUSTMENTS=0
DEXPAPRIKA_ALLOWED_MARKETS=
